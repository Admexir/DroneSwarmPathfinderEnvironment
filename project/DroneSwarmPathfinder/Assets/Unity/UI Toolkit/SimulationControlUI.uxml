<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SimulationUIStyleSheet.uss?fileID=7433441132597879392&amp;guid=5e66364d4afe8fd4c97d3fd72c2048d8&amp;type=3#SimulationUIStyleSheet"/>
    <ui:VisualElement picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; width: 100%; height: 100%;">
        <ui:VisualElement name="left-container" style="width: 250px; height: 100%;">
            <ui:VisualElement name="tab-header" style="flex-direction: row; height: 35px; margin-bottom: 5px;">
                <ui:Button name="tab-btn-editor" text="Editor" style="flex-grow: 1; margin: 0; border-radius: 4px 0 0 4px; -unity-font-style: bold;"/>
                <ui:Button name="tab-btn-playback" text="Playback" style="flex-grow: 1; margin: 0; border-radius: 0; -unity-font-style: bold;"/>
                <ui:Button name="tab-btn-file" text="File" style="flex-grow: 1; margin: 0; border-radius: 0 4px 4px 0; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="tab-content" style="flex-grow: 1;">
                <ui:VisualElement name="panel-editor" class="ToolsBackground" style="background-color: rgba(45, 45, 45, 0.2); padding: 10px; display: flex;">
                    <ui:Label text="EDITOR TOOLS" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                    <ui:Button text="Add Drone" name="btn-add-drone" class="EditorToolsButton"/>
                    <ui:Button text="Add Obstacle" name="btn-add-obstacle" class="EditorToolsButton"/>
                    <ui:Button text="Remove Selected" name="btn-remove-selected" class="EditorToolsButton"/>
                    <ui:Label text="ENVIRONMENT SETTINGS" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px; margin-top: 10px;"/>
                    <ui:IntegerField label="Grid Size" name="input-grid-size" value="1" style="color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="panel-playback" class="ToolsBackground PlaybackToolsBackground" style="background-color: rgba(45, 45, 45, 0.2); padding: 10px; display: none;">
                    <ui:Label text="PLAYBACK" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                    <ui:Label text="Time Scale: 100%" name="time-scale-label" style="margin-bottom: 2px; -unity-font-style: bold; color: rgb(220, 220, 220);"/>
                    <ui:SliderInt value="100" high-value="100" name="time-scale-slider" style="margin-bottom: 15px;"/>
                    <ui:Button text="Play" name="btn-play" class="PlaybackControlButton"/>
                    <ui:Button text="Step &gt;" name="btn-step-forward" class="PlaybackControlButton"/>
                    <ui:Button text="Step &lt;" name="btn-step-back" class="PlaybackControlButton"/>
                    <ui:Button text="Restart" name="btn-restart" class="PlaybackControlButton" style="margin-bottom: 15px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="panel-file" class="ConfigToolsPanel ConfigToolsBackground" style="background-color: rgba(45, 45, 45, 0.2); padding: 10px; display: none; flex-direction: column;">
                    <ui:ScrollView style="flex-grow: 1;">
                        <ui:Label text="SCENE CONFIGURATIONS" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                        <ui:Toggle label="Use Physics" name="toggle-use-physics" value="false" style="margin-bottom: 10px; color: rgb(200, 200, 200);"/>
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 4px;">
                            <ui:Button text="Load Swarm" name="btn-load-config" class="ConfigToolsButton" style="flex-grow: 1; height: 35px; -unity-font-style: bold; margin: 0 2px 0 0; padding: 0;"/>
                            <ui:Button text="Load Env" name="btn-load-env" class="ConfigToolsButton" style="flex-grow: 1; height: 35px; -unity-font-style: bold; margin: 0 0 0 2px; padding: 0;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 15px;">
                            <ui:Button text="Export Swarm" name="btn-export-config" class="ConfigToolsButton" style="flex-grow: 1; height: 35px; -unity-font-style: bold; margin: 0 2px 0 0; padding: 0;"/>
                            <ui:Button text="Export Env" name="btn-export-env" class="ConfigToolsButton" style="flex-grow: 1; height: 35px; -unity-font-style: bold; margin: 0 0 0 2px; padding: 0;"/>
                        </ui:VisualElement>
                        <ui:Label text="ALGORITHM SELECTION" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                        <ui:Label text="Select:" style="color: rgb(200, 200, 200); margin-bottom: 2px;" />
                        <ui:DropdownField name="dropdown-algorithms" style="margin-left: 0; margin-right: 0; margin-bottom: 5px; color: black; flex-grow: 1; width: 100%;" />
                        <ui:Button text="Import External DLL..." name="btn-load-algorithm" class="ConfigToolsButton" style="height: 30px; margin-bottom: 10px;"/>
                        <ui:Button text="Run Algorithm" name="btn-play-sim" class="ConfigToolsButton" style="height: 40px; -unity-font-style: bold; margin-bottom: 5px; background-color: rgba(50, 120, 50, 0.8);"/>
                        <ui:Label text="SCENARIO SETTINGS" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px; margin-top: 5px;"/>
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 2px;">
                            <ui:Button text="Select Starting Config" name="btn-start-config" class="ConfigToolsButton" style="flex-grow: 1; height: 30px; margin-right: 5px;"/>
                            <ui:VisualElement name="icon-start-config" tooltip="No file selected" style="width: 30px; height: 30px; background-color: rgb(150, 50, 50); border-radius: 4px; padding: 4px; align-items: center; justify-content: center;">
                                <ui:VisualElement class="scenario-icon-img" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit;">
                                    <ui:Label text="X" style="color: white; -unity-font-style: bold; margin: 0; padding: 0;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Toggle label="Use Current Scene" name="toggle-current-scene" value="true" style="margin-bottom: 10px; color: rgb(200, 200, 200);"/>
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 15px;">
                            <ui:Button text="Select Target Config" name="btn-target-config" class="ConfigToolsButton" style="flex-grow: 1; height: 30px; margin-right: 5px;"/>
                            <ui:VisualElement name="icon-target-config" tooltip="No file selected" style="width: 30px; height: 30px; background-color: rgb(150, 50, 50); border-radius: 4px; padding: 4px; align-items: center; justify-content: center;">
                                <ui:VisualElement class="scenario-icon-img" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit;">
                                    <ui:Label text="X" style="color: white; -unity-font-style: bold; margin: 0; padding: 0;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right-container" class="InspectorBackground" style="width: 300px; height: 100%; padding: 10px;">
            <ui:Label text="INSPECTOR" class="InspectorH1" style="margin-bottom: 10px;"/>
            <ui:ScrollView style="flex-grow: 1;">
                <ui:Foldout text="Drones" name="foldout-drones" value="true" class="InspectorH2">
                    <ui:ListView name="drone-list-view" selection-type="Multiple" class="InspectorListElement" style="min-height: 100px; max-height: 250px; background-color: rgba(0, 0, 0, 0.3); margin-bottom: 5px; border-radius: 5px;"/>
                    <ui:VisualElement name="drone-details-panel">
                        <ui:TextField label="Drone ID" name="input-drone-id" readonly="true" class="InspectorLabel" style="margin-bottom: 5px;"/>
                        <ui:IntegerField label="Group" name="input-drone-group" class="InspectorLabel" style="margin-bottom: 5px;"/>
                        <ui:VisualElement class="InspectorLabel" style="margin-bottom: 5px;">
                            <ui:Label text="Position" class="InspectorLabel" style="margin-bottom: 2px;"/>
                            <ui:Vector3Field name="input-drone-position" class="InspectorLabel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Foldout>
                <ui:Foldout text="Other" name="foldout-other" value="false" class="InspectorH2" style="margin-top: 10px;">
                    <ui:ListView name="obstacle-list-view" selection-type="Multiple" class="InspectorListElement" style="min-height: 100px; max-height: 250px; background-color: rgba(0, 0, 0, 0.3); margin-bottom: 5px; border-radius: 5px;"/>
                    <ui:VisualElement name="obstacle-details-panel">
                        <ui:TextField label="Obstacle ID" name="input-obstacle-id" readonly="true" class="InspectorLabel" style="margin-bottom: 5px;"/>
                        <ui:VisualElement class="InspectorLabel" style="margin-bottom: 5px;">
                            <ui:Label text="Position" class="InspectorLabel" style="margin-bottom: 2px;"/>
                            <ui:Vector3Field name="input-obstacle-position" class="InspectorLabel"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="InspectorLabel" style="margin-bottom: 5px;">
                            <ui:Label text="Size" class="InspectorLabel" style="margin-bottom: 2px;"/>
                            <ui:Vector3Field name="input-obstacle-size" class="InspectorLabel"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Foldout>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="floating-toolbar" style="position: absolute; left: 300px; top: 50px; flex-direction: row; background-color: rgba(35, 35, 35, 0.9); border-radius: 6px; border-width: 1px; border-color: rgb(20, 20, 20); padding: 4px;">
            <ui:VisualElement name="drag-handle" style="width: 15px; height: 100%; cursor: move-arrow; background-color: rgba(80, 80, 80, 0.5); border-radius: 3px; margin-right: 5px; align-items: center; justify-content: center;">
                <ui:VisualElement style="width: 4px; height: 4px; background-color: rgb(150, 150, 150); border-radius: 2px; margin-bottom: 2px;"/>
                <ui:VisualElement style="width: 4px; height: 4px; background-color: rgb(150, 150, 150); border-radius: 2px; margin-bottom: 2px;"/>
                <ui:VisualElement style="width: 4px; height: 4px; background-color: rgb(150, 150, 150); border-radius: 2px;"/>
            </ui:VisualElement>
            <ui:Button name="tool-btn-select" text="X" class="floating-tool-btn ToolsBarButton" style="width: 40px; height: 40px; margin: 2px; padding: 0; background-color: rgb(70, 70, 70); border-radius: 4px;"/>
            <ui:Button name="tool-btn-move" text="Mov" class="floating-tool-btn ToolsBarButton" style="width: 40px; height: 40px; margin: 2px; padding: 0; border-radius: 4px;"/>
            <ui:Button name="tool-btn-scale" text="Sca" class="floating-tool-btn ToolsBarButton" style="width: 40px; height: 40px; margin: 2px; padding: 0; border-radius: 4px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
