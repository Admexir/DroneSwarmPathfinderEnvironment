<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; width: 100%; height: 100%;">
        <ui:VisualElement name="left-container" style="width: 250px; height: 100%; justify-content: space-between;">
            <ui:VisualElement name="tool-panel" style="background-color: rgba(45, 45, 45, 0.2); padding: 10px;">
                <ui:Label text="PLAYBACK" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                <ui:Label text="Time Scale: 100%" name="time-scale-label" style="margin-bottom: 2px; -unity-font-style: bold; color: rgb(220, 220, 220);"/>
                <ui:SliderInt value="100" high-value="100" name="time-scale-slider" style="margin-bottom: 15px;"/>
                <ui:Button text="Play" name="btn-play"/>
                <ui:Button text="Step &gt;" name="btn-step-forward"/>
                <ui:Button text="Step &lt;" name="btn-step-back"/>
                <ui:Button text="Restart" name="btn-restart" style="margin-bottom: 15px;"/>
                <ui:Label text="EDITOR TOOLS" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-bottom: 5px;"/>
                <ui:Button text="Add Drone" name="btn-add-drone"/>
                <ui:Button text="Add Obstacle" name="btn-add-obstacle"/>
                <ui:Button text="Remove Selected" name="btn-remove-selected"/>
            </ui:VisualElement>
            <ui:VisualElement name="main-actions-panel" style="background-color: rgba(45, 45, 45, 0.2); padding: 10px;">
                <ui:Button text="Load Configuration" name="btn-load-config" style="height: 40px; -unity-font-style: bold; margin-bottom: 5px;"/>
                <ui:Button text="Play Simulation" name="btn-play-sim" style="height: 40px; -unity-font-style: bold; margin-bottom: 5px; background-color: rgba(50, 120, 50, 0.8);"/>
                <ui:Button text="Export Configuration" name="btn-export-config" style="height: 40px; -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right-container" style="width: 300px; height: 100%; background-color: rgba(45, 45, 45, 0.2); padding: 10px;">
            <ui:Label text="INSPECTOR" style="-unity-font-style: bold; color: rgb(220, 220, 220); margin-bottom: 10px;"/>
            
            <ui:ScrollView style="flex-grow: 1;">
                <ui:Foldout text="Drones" name="foldout-drones" value="true" style="-unity-font-style: bold; color: rgb(200, 200, 200);">
                    <ui:ListView name="drone-list-view" selection-type="Multiple" style="min-height: 100px; max-height: 250px; background-color: rgba(0, 0, 0, 0.3); margin-bottom: 5px; border-radius: 5px; -unity-font-style: normal;"/>
                    <ui:VisualElement name="drone-details-panel" style="-unity-font-style: normal;">
                        <ui:TextField label="Drone ID" name="input-drone-id" readonly="true" style="margin-bottom: 5px;"/>
                        <ui:IntegerField label="Group" name="input-drone-group" style="margin-bottom: 5px;"/>
                        <ui:Vector3Field label="Position" name="input-drone-position" style="margin-bottom: 5px;"/>
                    </ui:VisualElement>
                </ui:Foldout>

                <ui:Foldout text="Other" name="foldout-other" value="false" style="-unity-font-style: bold; color: rgb(200, 200, 200); margin-top: 10px;">
                    <ui:ListView name="obstacle-list-view" selection-type="Multiple" style="min-height: 100px; max-height: 250px; background-color: rgba(0, 0, 0, 0.3); margin-bottom: 5px; border-radius: 5px; -unity-font-style: normal;"/>
                    <ui:VisualElement name="obstacle-details-panel" style="-unity-font-style: normal;">
                        <ui:TextField label="Obstacle ID" name="input-obstacle-id" readonly="true" style="margin-bottom: 5px;"/>
                        <ui:Vector3Field label="Position" name="input-obstacle-position" style="margin-bottom: 5px;"/>
                        <ui:Vector3Field label="Size" name="input-obstacle-size" style="margin-bottom: 5px;"/>
                    </ui:VisualElement>
                </ui:Foldout>
            </ui:ScrollView>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>